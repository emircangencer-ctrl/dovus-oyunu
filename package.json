{
  "name": "dovus-oyunu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
